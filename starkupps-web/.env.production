# StarKupps Web — production build values (loaded by `vite build`).
#
# Why this file exists: `.env` is gitignored, so it never reaches Vercel and a
# production build would otherwise find no API base URL and fall back to calling
# its own origin (every request 404s). Vite loads `.env.production` for
# `mode=production`, which is what Vercel runs.
#
# Every value here is public by design — each one is inlined into the browser
# bundle. NEVER add a service-role/secret key to this file.

# Admin gateway (REST /api/public/*, with tRPC public.* fallback). No trailing slash.
VITE_API_URL=https://starkupps-admin-261175458017.asia-northeast2.run.app

# Supabase project (auth + realtime menu sync). Must match the gateway's project.
VITE_SUPABASE_URL=https://njqrcxtjzghlyrmgsrmq.supabase.co

# Public keys only — these are designed to be exposed and are protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_iXBbyIaHbeG6visVP8ewjA_-2a-T4_p
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5qcXJjeHRqemdobHlybWdzcm1xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTA3NDM1NjYsImV4cCI6MjEwNjMxOTU2Nn0.4fUIjDdaccpl9_0ZYvg9i2j2uaE29T52t-9mbFqvTlE