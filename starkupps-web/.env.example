# StarKupps Web — client environment
#
# Vite only exposes variables prefixed with VITE_ to browser code, and every one
# of them is inlined into the public bundle. NEVER prefix a secret with VITE_.
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# In production, set these in your hosting provider's dashboard.
#
# The app degrades gracefully: without Supabase the menu still loads over HTTP,
# and sign-in surfaces a "not configured" notice instead of crashing.

# ── Admin gateway (required in production) ──────────────────────────────────
# Base URL of starkupps-admin (REST /api/public/*, with tRPC public.* fallback).
# No trailing slash. Leave empty to call same-origin /api/public — which the
# dev server proxies to http://localhost:3000 by default.
#
# PRODUCTION builds do NOT read this file. `vite build` uses `.env.production`,
# which is committed and already holds the live gateway URL. Set VITE_API_URL in
# the hosting dashboard only if you need to override that per-deployment.
VITE_API_URL=http://localhost:3000
# Accepted alias for VITE_API_URL.
# VITE_ADMIN_URL=http://localhost:3000

# Optional: override the dev-server proxy target (defaults to localhost:3000).
# VITE_DEV_API_PROXY=http://localhost:3000

# ── Supabase (required for auth and live menu sync) ─────────────────────────
# Public anon/publishable keys — safe to expose. Use your own project's values
# from the Supabase dashboard. Must point at the SAME project as starkupps-admin.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Accepted alias for VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Deployed domains ────────────────────────────────────────────────────────
# The storefront is served from https://starkupps.in and https://starkupps.com
# (both apex and www). These origins MUST be present in the gateway's
# CORS_ORIGINS or every API call is rejected in the browser:
#   https://starkupps.in
#   https://starkupps.com
#   https://www.starkupps.in
#   https://www.starkupps.com
#
# Vercel preview deployments get a unique *.vercel.app origin each time. The
# gateway matches origins exactly (no wildcards), so a preview build cannot read
# the API until its origin is added — promote previews to a test hostname if you
# need them functional.

# ── Local server ports (optional) ───────────────────────────────────────────
# VITE_PORT=5173
# VITE_PREVIEW_PORT=4173

# ── Google Maps (optional) ──────────────────────────────────────────────────
# Draws the delivery map so the customer can drag the pin to their door.
#
# This key IS visible to anyone who loads the page — the Maps JavaScript API is
# fetched by the browser, so it cannot be kept secret. Restrict it instead:
#   * API restriction   -> Maps JavaScript API ONLY (never Geocoding API)
#   * HTTP referrer     -> https://starkupps.in, https://starkupps.com,
#                          https://www.starkupps.in, https://www.starkupps.com
# Reverse-geocoding deliberately does NOT use this key; it goes through the
# gateway (GOOGLE_MAPS_API_KEY, server-side) so no geocoding-capable key is ever
# sent to a customer.
#
# Leave empty (or unset) to hide the map. "Use my current location" and the
# address field keep working either way.
# VITE_GOOGLE_MAPS_API_KEY=
# Optional Cloud-based map styling id.
# VITE_GOOGLE_MAPS_MAP_ID=

# ── Never put these here ────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY — bypasses row-level security; admin-only.
# Any other secret. This is a browser bundle.