# StarKupps Web — client environment
#
# Vite only exposes variables prefixed with VITE_ to browser code, and every one
# of them is inlined into the public bundle. NEVER prefix a secret with VITE_.
#
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
# In production, set these in your hosting provider's dashboard.
#
# The app degrades gracefully: without Supabase the menu still loads over HTTP,
# and sign-in surfaces a "not configured" notice instead of crashing.

# ── Admin gateway (required in production) ──────────────────────────────────
# Base URL of starkupps-admin (REST /api/public/*, with tRPC public.* fallback).
# No trailing slash. Leave empty to call same-origin /api/public — which the
# dev server proxies to http://localhost:3000 by default.
VITE_API_URL=http://localhost:3000
# Accepted alias for VITE_API_URL.
# VITE_ADMIN_URL=http://localhost:3000

# Optional: override the dev-server proxy target (defaults to localhost:3000).
# VITE_DEV_API_PROXY=http://localhost:3000

# ── Supabase (required for auth and live menu sync) ─────────────────────────
# Public anon/publishable keys — safe to expose. Use your own project's values
# from the Supabase dashboard. Must point at the SAME project as starkupps-admin.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Accepted alias for VITE_SUPABASE_ANON_KEY.
# VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── Local server ports (optional) ───────────────────────────────────────────
# VITE_PORT=5173
# VITE_PREVIEW_PORT=4173

# ── Never put these here ────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY — bypasses row-level security; admin-only.
# Any other secret. This is a browser bundle.