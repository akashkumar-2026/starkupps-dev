# StarKupps Admin — environment
#
# Two audiences read this file, and the split matters:
#
#   VITE_*  Only these reach the browser. Vite inlines them into the public
#           bundle at build time, so they are public. NEVER prefix a secret
#           with VITE_.
#   (rest)  Server-only. Read through `server/config/env.ts`, which fails fast
#           on a missing or weak value in production.
#
# Copy to `.env.local` for local development:  cp .env.example .env.local
# In production, set these in your hosting provider's dashboard instead.
#
# See README.md for the full setup and AUTH.md for the session model.

# ── Browser (VITE_*) ────────────────────────────────────────────────────────
# Dev-server proxy target for /api. Only used by `npm run dev`; production is
# served by the Express gateway, which owns /api itself.
# VITE_DEV_API_PROXY=http://localhost:3000

# Ports for `npm run dev` and `npm run preview`. Setting VITE_PORT also makes
# the dev server fail fast instead of auto-incrementing to the next free port.
# VITE_PORT=5173
# VITE_PREVIEW_PORT=4173

# Browser-restricted Google Maps key for the ADMIN UI's location picker. Without
# it the picker degrades to a read-only coordinate panel instead of a map.
# Visible to anyone signed in — restrict to Maps JavaScript API + your origin.
# VITE_GOOGLE_MAPS_API_KEY=
# Optional Cloud-based map styling id.
# VITE_GOOGLE_MAPS_MAP_ID=

# SERVER-SIDE Google Geocoding key — the secret one. Never prefix with VITE_.
# Used by server/lib/geocode.ts to reverse-geocode the storefront's delivery
# coordinates. Restrict to the Geocoding API and to this gateway's egress IPs,
# and keep it separate from the VITE_ key above. Unset ⇒ falls back to Nominatim.
# GOOGLE_MAPS_API_KEY=

# Where sign-out sends the browser.
# VITE_LOGIN_URL=/auth/login

# ── Supabase ─────────────────────────────────────────────────────────────────
# One project holds both the API gateway and the public storefront
# (starkupps-web). The anon key is safe to expose; the service-role key is not
# and is only ever read on the server.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# New-style publishable key, if your project uses one instead of the anon key.
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Personal Access Token (sbp_...) for the Supabase CLI. Used by the
# `supabase:*` scripts only — never needed by the app or the gateway.
# SUPABASE_ACCESS_TOKEN=

# Database URLs. Pooled (6543) for the running app, direct (5432) for
# migrations. Never exposed to the browser.
# DATABASE_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgres://postgres.your-project:password@aws-0-region.pooler.supabase.com:5432/postgres
# DATABASE_URL=
# DIRECT_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Signs every session, refresh and reset token (HS256). Startup FAILS in
# production if this is missing, under 32 characters, or a placeholder.
#   openssl rand -base64 48
SESSION_SECRET=replace-me-with-a-random-secret-of-48-bytes
# The first account, granted the owner role on first sign-in.
OWNER_EMAIL=admin@starkupps.local
OWNER_OPEN_ID=admin@starkupps.local

# Absolute origin of this deployment. Must be https:// in production: session
# cookies are issued with the Secure flag.
APP_URL=http://localhost:5173

# "Remember on this device" — lifetime of a persistent device session (days).
# Unchecked on the login form means a browser-session cookie bounded by
# AUTH_SESSION_HOURS instead. Range 1-365.
AUTH_REMEMBER_DAYS=30
# Access-token (JWT) lifetime in seconds. Deliberately short: the cookie may
# outlive it, but a stolen cookie is only useful for this window. Min 300.
AUTH_ACCESS_TOKEN_SEC=3600
# Absolute ceiling on a NON-remembered device session, in hours. The cookie has
# no Max-Age (it dies with the browser); this bounds the server-side record.
AUTH_SESSION_HOURS=12
# A session unused for this long is rejected, even before its absolute expiry.
# Max 43200 (30 days).
AUTH_IDLE_TIMEOUT_MIN=120
# Sensitive actions (change password, change role) require a password check
# within this window, even on a remembered device. Min 1.
AUTH_REAUTH_WINDOW_MIN=15
# How often the in-process janitor prunes expired sessions and reset tokens.
# Min 60000.
AUTH_CLEANUP_INTERVAL_MS=3600000

# Login throttling. Attempts are counted generously; only FAILURES are counted
# strictly, so one busy admin behind a shared IP cannot lock out everyone.
AUTH_LOGIN_ATTEMPT_MAX=30
AUTH_LOGIN_FAILURE_MAX=10
AUTH_LOGIN_WINDOW_MIN=15

# Reverse proxy / TLS termination.
# Leave FALSE unless the app sits behind a proxy you control. When false,
# X-Forwarded-For and X-Forwarded-Proto are IGNORED and the socket address is
# used — otherwise a client can spoof its own IP (defeating rate limiting) and
# force insecure cookie attributes. Set true (or a hop count) only when a
# trusted proxy OVERWRITES those headers rather than appending to them.
TRUST_PROXY=false
# How many proxy hops to trust. Read only when TRUST_PROXY is set.
TRUST_PROXY_HOPS=1

# ── Gateway ─────────────────────────────────────────────────────────────────
# Port the Express gateway listens on. 3000 in development and production.
PORT=3000
NODE_ENV=development

# Storefront rebuild hook (SEO freshness, server-side only — never VITE_).
# Vercel Deploy Hook URL that rebuilds starkupps-web after a storefront-visible
# mutation (menu, site content, FAQs, hours, Instagram). Create it in Vercel
# (Project → Settings → Git → Deploy Hooks) and set it in the Cloud Run env.
# Unset ⇒ no rebuild is triggered (safe default for local dev).
# SEO_REBUILD_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...

# Cross-origin allowlist for the storefront (starkupps-web), comma-separated.
# Leave empty to allow any localhost origin in development. Never use `*`:
# the gateway sends credentials, which a wildcard origin cannot.
# CORS_ORIGINS=https://starkupps.example.com,https://www.starkupps.example.com
# CORS_ORIGINS=

# ── Password-reset email ─────────────────────────────────────────────────────
# Delivery is optional: with neither provider configured the reset link is only
# logged, and production warns. Resend is preferred; SMTP is the fallback.
# RESEND_API_KEY=
# RESEND_FROM=StarKupps <noreply@starkupps.com>
# SMTP_URL=smtp://user:password@smtp.example.com:587

# ── Storage fallback (optional) ──────────────────────────────────────────────
# Supabase Storage is the primary. S3 is only used if it is configured.
# S3_BUCKET=
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Never put these in this file ─────────────────────────────────────────────
# Any secret with a VITE_ prefix — it would ship inside the public bundle.
# A real SESSION_SECRET, database password, or service-role key committed to
# git. Rotate anything that has been.
